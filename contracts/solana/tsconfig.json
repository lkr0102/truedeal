{
  "compilerOptions": {
    "types":            ["mocha", "chai"],
    "lib":              ["es2015"],
    "module":           "commonjs",
    "target":           "es6",
    "esModuleInterop":  true,
    "moduleResolution": "node",
    "strict":           false,
    "resolveJsonModule": true,
    "skipLibCheck":     true
  }
}
