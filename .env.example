# ─────────────────────────────────────────────────────────────────────────────
# TRUEDEAL ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Obter em: app.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Solana ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_TRUEDEAL_PROGRAM_ID=9zfQ1dwJ9Po7YCPWJ3S13ic3nxZcA9cEwBVsXdKub1c4

# ── Oracle Keypairs (DealGuard Consensus Nodes) ───────────────────────────────
# These are SERVER-SIDE ONLY — never expose to the client.
#
# APP_FEE_PAYER_KEY  — Oracle Node 1 & transaction fee payer (base64 of 64-byte secret key)
# APP_ORACLE2_KEY    — Oracle Node 2 for DealGuard multi-sig consensus (base64 of 64-byte secret key)
#
# To generate a new keypair, run:
#   node -e "const k=require('@solana/web3.js').Keypair.generate(); console.log('PubKey:', k.publicKey.toBase58(), '\nBase64:', Buffer.from(k.secretKey).toString('base64'))"
#
# Then airdrop SOL on devnet to the fee payer:
#   solana airdrop 2 <pubkey> --url devnet
#
APP_FEE_PAYER_KEY=
APP_ORACLE2_KEY=

# ── Wallet Security ───────────────────────────────────────────────────────────
# 64-character hex string (32 bytes) used for AES-256-GCM user wallet encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_MASTER_KEY=

# ── X (Twitter) OAuth 2.0 ─────────────────────────────────────────────────────
# Criar app em: developer.twitter.com > Projects > Apps > OAuth 2.0
# Callback URL a registrar: http://localhost:3000/api/auth/callback/x  (dev)
#                           https://seudominio.com/api/auth/callback/x (prod)
# Permissões necessárias: Read (users.read, tweet.read)
NEXT_PUBLIC_APP_URL=http://localhost:3000
X_CLIENT_ID=
X_CLIENT_SECRET=
